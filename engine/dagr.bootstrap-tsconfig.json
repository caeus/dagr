{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "build",
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "declaration": false,
    "types": [
      "node"
    ],
    "paths": {
      "#*": [
        "./src/*"
      ]
    }
  }
}
