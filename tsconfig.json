{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "include": ["src/**/*"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "build",
    "types": ["node"],
    "sourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": "build/tsconfig.tsbuildinfo"
  }
}
